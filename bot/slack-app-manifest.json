{
  "display_information": {
    "name": "NSR Sales Bot",
    "description": "Answers questions about NSR sales KPIs from live AccuLynx + Active Knocker data.",
    "background_color": "#000000"
  },
  "features": {
    "bot_user": {
      "display_name": "NSR Sales Bot",
      "always_online": true
    },
    "assistant_view": {
      "assistant_description": "Ask me about weekly sales, door knocking, rep performance, and pace to BHAG."
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "im:history",
        "im:read",
        "im:write",
        "assistant:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "message.im",
        "assistant_thread_started"
      ]
    },
    "interactivity": { "is_enabled": true },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
