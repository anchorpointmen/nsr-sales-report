# Copy to .env for local runs (never commit .env). In production these live as
# GitHub repo secrets (Settings → Secrets and variables → Actions).

# --- AccuLynx (REST v2) ---
# Generate at my.acculynx.com/apikeys (admin required). One key per location.
ACCULYNX_API_KEY=

# --- Active Knocker ---
# Key from Configuration → Integration → API Key (toggle ON, then Copy).
ACTIVEKNOCKER_API_KEY=
# Get these two from Active Knocker support (support@activeknocker.com):
ACTIVEKNOCKER_BASE_URL=
ACTIVEKNOCKER_ACTIVITY_PATH=
# Flip to true once base URL + path are filled in and verified via probe.
ACTIVEKNOCKER_READY=false

# --- Slack ---
# Incoming Webhook URL for the channel you want the report posted to.
SLACK_WEBHOOK_URL=

# --- Slack bot (bot/app.js, deployed on Railway, NOT used by the report) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
ANTHROPIC_API_KEY=
